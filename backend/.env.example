# Copy to .env. Never commit .env.
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false

# Database (PostgreSQL 15+ with the pgvector extension)
DATABASE_URL=postgresql+asyncpg://legal:legal@localhost:5432/legal_rights

# Redis is optional. Empty = in-memory rate limiting (single process only).
REDIS_URL=

# Auth. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# CORS: JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Limits
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60

# LLM provider: ollama | nvidia
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=120

# NVIDIA API (server-side only; never sent to the frontend)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=               # NVIDIA-hosted GLM id; e.g. z-ai/glm-5.3-flash (listed by GET /v1/models on 2026-10-31)
NVIDIA_EMBEDDING_MODEL=          # multilingual embedding model id
EMBEDDING_DIM=1024               # must match the model; changing it needs a new migration
NVIDIA_TIMEOUT_SECONDS=60
NVIDIA_MAX_RETRIES=3

# Data retention
UPLOAD_RETENTION_DAYS=30
STORAGE_DIR=storage
